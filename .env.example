# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
SESSION_LIFETIME=28800

# Database Configuration
# Production cPanel: always point to MySQL/MariaDB, not SQLite.
DATABASE_URL=mysql://cpanel_user:strong_password@localhost/cpanel_db_name

# Data Root Configuration
# Keep mutable files outside public_html on hosting.
PC06_DATA_DIR=/home/cpanel_user/pc06_data

# File Upload Configuration
UPLOAD_FOLDER=uploads
TASK_FOLDER=task_files
LIB_FOLDER=library_files
BACKUP_FOLDER=backups
REPORT_TEMPLATE_FOLDER=report_templates
REPORT_EXPORT_FOLDER=report_exports
LOG_DIR=logs
TMP_FOLDER=tmp
MAX_CONTENT_LENGTH=16777216

# AI Assistant Configuration
AI_ASSISTANT_PROVIDER=deepseek
AI_ASSISTANT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your_deepseek_key_here

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Zalo Integration (Optional)
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_CALLBACK_URL=

# Application Environment
FLASK_ENV=production
DEBUG=False

# Logging
LOG_LEVEL=INFO
