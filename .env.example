# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
SESSION_LIFETIME=28800

# Force HTTPS redirect ở tầng app (mặc định bật khi FLASK_ENV=production)
# PC06_FORCE_HTTPS=1
FLASK_ENV=production

# Database Configuration
# Production cPanel: always point to MySQL/MariaDB, not SQLite.
DATABASE_URL=mysql://cpanel_user:strong_password@localhost/cpanel_db_name

# Data Root Configuration
# Keep mutable files outside public_html on hosting.
PC06_DATA_DIR=/home/cpanel_user/pc06_data

# File Upload Configuration
UPLOAD_FOLDER=uploads
TASK_FOLDER=task_files
LIB_FOLDER=library_files
BACKUP_FOLDER=backups
REPORT_TEMPLATE_FOLDER=report_templates
REPORT_EXPORT_FOLDER=report_exports
LOG_DIR=logs
TMP_FOLDER=tmp
MAX_CONTENT_LENGTH=16777216

# AI Assistant Configuration
# CHƯA TRIỂN KHAI: không có mã nào đọc các biến này (tính năng LLM mới ở
# mức ý tưởng trong lộ trình). Khai báo ở đây từng gây hiểu nhầm là hệ thống
# đã có trợ lý AI. Nếu triển khai thật, thêm lại kèm code tương ứng.

# Deadline Watchdog (Pha 1) — cảnh báo hạn tự động
# Chạy qua POST /admin/deadline-watchdog/run (quyền sys/process) hoặc cron:
#   * * * * * curl -s -X POST -H "Cookie: ..." https://<host>/admin/deadline-watchdog/run
# (cấu hình cron thực tế cần phiên đăng nhập hợp lệ; xem docs đánh giá)
PC06_DEADLINE_UPCOMING_DAYS=3
# HOẶC chạy tự động qua scheduler nền (APScheduler) khi app khởi động
# (services/task_scheduler.py), mỗi PC06_WATCHDOG_HOURS giờ.
# PC06_TASK_SCHEDULER=0 để tắt scheduler (vẫn dùng được endpoint/cron).
PC06_TASK_SCHEDULER=1
PC06_WATCHDOG_HOURS=1
PC06_DEADLINE_URGENT_DAYS=1
PC06_DEADLINE_LOOKBACK_DAYS=7
PC06_DEADLINE_MAX_TASKS=500
# 0 = chỉ nhắc quá hạn 1 lần trong cửa sổ lookback; đặt 1/3 để nhắc lại định kỳ
PC06_DEADLINE_EMAIL_ENABLED=1

# Email Configuration (Optional)
# Watchdog + thông báo giao việc gửi email qua các biến MAIL_* này;
# chưa khai báo = tự bỏ qua gửi email (chỉ thông báo trong app).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Zalo Integration (Optional) — CHƯA CÓ MÃ TÍCH HỢP; giữ chỗ cho lộ trình
# gửi tin nhắc hạn tự động (Pha 1). Khai báo sớm chỉ để chuẩn bị.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_CALLBACK_URL=

# Google OAuth (Optional) — Đăng nhập bằng tài khoản Google
# Tạo OAuth Client ID tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://pc06tuyenquang.net/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Nếu bỏ trống, hệ thống tự suy từ host (có nhận biết X-Forwarded-Proto).
# Trên production NÊN ghim giá trị tuyệt đối để không phụ thuộc proxy:
GOOGLE_OAUTH_REDIRECT_URI=https://pc06tuyenquang.net/auth/google/callback
# Giới hạn theo đuôi miền email, ví dụ: gmail.com,congan.gov.vn (để trống = cho phép mọi email)
GOOGLE_OAUTH_ALLOWED_DOMAINS=

# Application Environment
FLASK_ENV=production
DEBUG=False

# Logging
LOG_LEVEL=INFO
